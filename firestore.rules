rules_version = '2';

// Simple rules: anyone may read categories and public tickets (anonymous mode);
// everything else needs a signed-in user. Paste into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /publicTickets/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
