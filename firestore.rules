rules_version = '2';

// Simple rules: anyone may read categories, public tickets and their photos (anonymous mode);
// everything else needs a signed-in user. Paste into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /publicTickets/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Photos of public tickets are visible to anonymous users too.
    match /tickets/{ticketId}/media/{mediaId} {
      allow read: if exists(/databases/$(database)/documents/publicTickets/$(ticketId));
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
